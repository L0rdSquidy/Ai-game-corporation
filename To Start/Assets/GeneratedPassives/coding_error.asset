        chanceInspector: 0.5
        radiusInspector: -1
        piercePercentInspector: -1
        statInspector: none
        stackTypeInspector: none
        maxStacksInspector: 0
    - effectType: ShieldOnHit
      parameters:
        valueTypeInspector: flat
        valueInspector: 20
        durationInspector: 4
        cooldownInspector: -1
        chanceInspector: 1
        radiusInspector: -1
        piercePercentInspector: -1
        statInspector: none
        stackTypeInspector: none
        maxStacksInspector: 0
    scaling:
      stat: strength
      ratio: 0.3
    balance:
      min_value: 25
      max_value: 50
      notes: Effect increases with the coder's strength and scales exponentially
        with up to 3 stacks
