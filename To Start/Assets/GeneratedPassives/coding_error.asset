  passive:
    id: coding_error
    name: Code Corruption
    description: 'When hit: deal additional physical damage of 30% (50% chance) and
      grant a shield of 20 over 4s when triggered'
    element: No-Attribute
    trigger: on_hit
    target: area
    effects:
    - effectType: PhysicalDamage
      parameters:
        valueTypeInspector: percent
        valueInspector: 30
        durationInspector: -1
