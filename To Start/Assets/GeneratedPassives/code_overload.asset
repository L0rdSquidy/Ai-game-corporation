  passive:
    id: code_overload
    name: Code Overload
    description: 'On dealing damage: reduce incoming damage by 20%'
    element: No-Attribute
    trigger: on_damage
    target: self
    effects:
    - effectType: DamageReduction
      parameters:
        valueTypeInspector: percent
        valueInspector: 20
        durationInspector: 3
        cooldownInspector: 5
        chanceInspector: 1
        radiusInspector: -1
        piercePercentInspector: -1
        statInspector: none
        stackTypeInspector: none
        maxStacksInspector: 0
    scaling:
      stat: intelligence
      ratio: 0.4
    balance:
      min_value: 30
      max_value: 60
      notes: Effect increases with the coder's intelligence and stacks linearly with
        up to 2 stacks
    notes: 
