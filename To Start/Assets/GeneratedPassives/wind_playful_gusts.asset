  passive:
    id: wind_playful_gusts
    name: Playful Gusts
    description: 'When hit: increase movement speed by 50% (80% chance) and gain
      20% dodge chance Element: wind.'
    element: wind
    trigger: on_hit
    target: self
    effects:
    - effectType: MovementSpeed
      parameters:
        valueTypeInspector: percent
        valueInspector: 50
        durationInspector: 3
        cooldownInspector: -1
        chanceInspector: 0.8
        radiusInspector: -1
        piercePercentInspector: -1
        statInspector: none
        stackTypeInspector: none
        maxStacksInspector: 0
    - effectType: DodgeChance
      parameters:
        valueTypeInspector: percent
        valueInspector: 20
        durationInspector: -1
        cooldownInspector: -1
        chanceInspector: 1
        radiusInspector: -1
        piercePercentInspector: -1
        statInspector: none
        stackTypeInspector: none
        maxStacksInspector: 0
    scaling:
      stat: agility
      ratio: 0.3
    balance:
      min_value: 10
      max_value: 35
      notes: Can be used in combat situations to avoid attacks and increase mobility
