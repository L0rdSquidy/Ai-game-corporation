%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d4293fd77b1018d47856183f3116e7e6, type: 3}
  m_Name: keyboard_rage
  m_EditorClassIdentifier: 
  passive:
    id: keyboard_rage
    name: Typing Frenzy
    description: 'When healed: increase attack speed by 20% and increase movement
      speed by 15%'
    element: No-Attribute
    trigger: on_heal
    target: ally
    effects:
    - effectType: AttackSpeed
      parameters:
        valueTypeInspector: percent
        valueInspector: 20
        durationInspector: 3
        cooldownInspector: 6
        chanceInspector: 1
        radiusInspector: -1
        piercePercentInspector: -1
        statInspector: none
        stackTypeInspector: none
        maxStacksInspector: 0
    - effectType: MovementSpeed
      parameters:
        valueTypeInspector: percent
        valueInspector: 15
        durationInspector: 3
        cooldownInspector: 6
        chanceInspector: 1
        radiusInspector: -1
        piercePercentInspector: -1
        statInspector: none
        stackTypeInspector: none
        maxStacksInspector: 0
    scaling:
      stat: agility
      ratio: 0.5
    balance:
      min_value: 20
      max_value: 40
      notes: Effect increases with the coder's agility and stacks exponentially with
        up to 2 stacks for allies
    notes: The coder also takes more damage during this passive
