  passive:
    id: wind_healing_breath
    name: Healing Breath
    description: 'When healed: instantly heal for 20% and grant a shield of 50 over
      3s when triggered Element: wind.'
    element: wind
    trigger: on_heal
    target: self
    effects:
    - effectType: InstantHeal
      parameters:
        valueTypeInspector: percent
        valueInspector: 20
        durationInspector: -1
        cooldownInspector: -1
        chanceInspector: 1
        radiusInspector: -1
        piercePercentInspector: -1
        statInspector: none
        stackTypeInspector: none
        maxStacksInspector: 0
    - effectType: ShieldOnHit
      parameters:
        valueTypeInspector: flat
        valueInspector: 50
        durationInspector: 3
        cooldownInspector: -1
        chanceInspector: 1
        radiusInspector: -1
        piercePercentInspector: -1
        statInspector: none
        stackTypeInspector: none
        maxStacksInspector: 0
    scaling:
      stat: health
      ratio: 0.2
    balance:
      min_value: 30
      max_value: 80
      notes: Can be used to recover health and protect myself during intense combat
        situations
